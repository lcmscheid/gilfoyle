#!/usr/bin/env bash
# Create gilfoyle's memory repo for this machine from the templates.
# Usage: gilfoyle-init [--seed <other-machine-memory-dir>]
set -euo pipefail

skill_dir=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
home=${GILFOYLE_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/gilfoyle}
seed=""

while [[ $# -gt 0 ]]; do
  case $1 in
    --seed) seed=${2:?--seed needs a directory}; shift 2 ;;
    -h|--help) sed -n '2,3p' "$0"; exit 0 ;;
    *) echo "gilfoyle-init: unknown argument: $1" >&2; exit 2 ;;
  esac
done

if [[ -e $home/MEMORY.md ]]; then
  echo "gilfoyle-init: memory already exists at $home" >&2
  exit 1
fi

mkdir -p "$home"
cp -r "$skill_dir/templates/memory/." "$home/"
host=$(uname -n)
sed -i "s/{{HOST}}/$host/; s/{{DATE}}/$(date +%F)/" "$home/MEMORY.md"

if [[ -n $seed ]]; then
  [[ -d $seed ]] || { echo "gilfoyle-init: seed is not a directory: $seed" >&2; exit 2; }
  mkdir -p "$home/seed/decisions"
  [[ -f $seed/preferences.md ]] && cp "$seed/preferences.md" "$home/seed/"
  shopt -s nullglob
  for f in "$seed"/decisions/*.md; do
    grep -q '^scope: portable' "$f" && cp "$f" "$home/seed/decisions/"
  done
  echo "gilfoyle-init: seeded from $seed into $home/seed (walk it during setup)"
fi

cd "$home"
git init -q
# A fresh machine may have no git identity yet; give this repo its own.
if ! git config user.name >/dev/null; then
  git config user.name "gilfoyle"
  git config user.email "gilfoyle@$host.localdomain"
fi
git add -A
git commit -q -m "gilfoyle: initialize memory for $host"
echo "$home"
